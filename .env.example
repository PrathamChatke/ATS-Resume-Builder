# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is already in .gitignore - it will never be committed.

# HS256 signing secret for login tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Your Google AI Studio API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# --- Only needed if using a hosted Postgres (e.g. Supabase) instead of local/Docker Postgres ---
# From Supabase: Project Settings -> Database -> Connection string -> use the "URI" tab,
# then use its host/user/password below. Use the direct connection (port 5432), not the
# pooler (6543) - Spring Boot already pools connections itself via HikariCP.
# Example host format: db.<your-project-ref>.supabase.co
SPRING_DATASOURCE_URL=jdbc:postgresql://<db-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=
